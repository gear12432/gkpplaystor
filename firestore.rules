rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'skjiyaul842@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Validation Blueprints (Pillar 2 & 5)
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.role is string && data.role in ['super_admin', 'admin']
        && data.createdAt is timestamp;
    }

    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoUrl', 'accountStatus', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'accountStatus', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoUrl is string && data.photoUrl.size() <= 2000
        && data.accountStatus is string && data.accountStatus in ['active', 'suspended']
        && data.role is string && data.role in ['super_admin', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApkApp(data) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'developer', 'packageName', 'category',
          'version', 'size', 'minAndroid', 'releaseDate', 'shortDescription',
          'fullDescription', 'whatsNew', 'iconUrl', 'screenshotUrls',
          'apkFileName', 'apkDownloadUrl', 'externalDownloadUrl', 'status',
          'downloadEnabled', 'featured', 'trending', 'downloads', 'rating',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'developer', 'packageName', 'category',
          'version', 'size', 'minAndroid', 'releaseDate', 'shortDescription',
          'fullDescription', 'whatsNew', 'iconUrl', 'screenshotUrls',
          'apkFileName', 'apkDownloadUrl', 'externalDownloadUrl', 'status',
          'downloadEnabled', 'featured', 'trending', 'downloads', 'rating',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128 && data.slug.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.developer is string && data.developer.size() >= 1 && data.developer.size() <= 140
        && data.packageName is string && data.packageName.size() >= 3 && data.packageName.size() <= 180
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 60
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 40
        && data.minAndroid is string && data.minAndroid.size() >= 1 && data.minAndroid.size() <= 80
        && data.releaseDate is string && data.releaseDate.size() >= 1 && data.releaseDate.size() <= 60
        && data.shortDescription is string && data.shortDescription.size() >= 1 && data.shortDescription.size() <= 500
        && data.fullDescription is string && data.fullDescription.size() >= 1 && data.fullDescription.size() <= 5000
        && data.whatsNew is string && data.whatsNew.size() <= 2000
        && data.iconUrl is string && data.iconUrl.size() <= 150000
        && data.screenshotUrls is list && data.screenshotUrls.size() <= 6
        && (data.screenshotUrls.size() == 0 || (data.screenshotUrls[0] is string && data.screenshotUrls[0].size() <= 150000))
        && data.apkFileName is string && data.apkFileName.size() <= 240
        && data.apkDownloadUrl is string && data.apkDownloadUrl.size() <= 2000
        && data.externalDownloadUrl is string && data.externalDownloadUrl.size() <= 2000
        && data.status is string && data.status in ['active', 'inactive']
        && data.downloadEnabled is bool
        && data.featured is bool
        && data.trending is bool
        && data.downloads is int && data.downloads >= 0
        && (data.rating is int || data.rating is float) && data.rating >= 0 && data.rating <= 5
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'description', 'iconUrl', 'totalApps', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'iconUrl', 'totalApps', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100
        && data.description is string && data.description.size() <= 600
        && data.iconUrl is string && data.iconUrl.size() <= 100000
        && data.totalApps is int && data.totalApps >= 0
        && data.status is string && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBanner(data) {
      return data.keys().hasAll([
          'id', 'title', 'subtitle', 'desktopBannerUrl', 'mobileBannerUrl',
          'buttonText', 'destinationUrl', 'position', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'subtitle', 'desktopBannerUrl', 'mobileBannerUrl',
          'buttonText', 'destinationUrl', 'position', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.desktopBannerUrl is string && data.desktopBannerUrl.size() <= 150000
        && data.mobileBannerUrl is string && data.mobileBannerUrl.size() <= 150000
        && data.buttonText is string && data.buttonText.size() <= 80
        && data.destinationUrl is string && data.destinationUrl.size() <= 1000
        && data.position is string && data.position in ['hero', 'mid_promo', 'footer_promo', 'category_top']
        && data.status is string && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDownloadEvent(data) {
      return data.keys().hasAll([
          'id', 'targetId', 'targetType', 'appName', 'packageName', 'version', 'dateKey', 'monthKey', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'targetId', 'targetType', 'appName', 'packageName', 'version', 'dateKey', 'monthKey', 'createdAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.targetType is string && data.targetType in ['app', 'game']
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 140
        && data.packageName is string && data.packageName.size() >= 3 && data.packageName.size() <= 180
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 60
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && data.monthKey is string && data.monthKey.size() >= 6 && data.monthKey.size() <= 20
        && data.createdAt is timestamp;
    }

    function isValidAnalyticsSummary(data) {
      return data.keys().hasAll(['id', 'periodType', 'label', 'downloads', 'updatedAt'])
        && data.keys().hasOnly(['id', 'periodType', 'label', 'downloads', 'updatedAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.periodType is string && data.periodType in ['daily', 'weekly', 'monthly']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 64
        && data.downloads is int && data.downloads >= 0
        && data.updatedAt is timestamp;
    }

    function isValidWebsiteSettings(data) {
      return data.keys().hasAll([
          'id', 'websiteName', 'websiteLogoUrl', 'websiteFaviconUrl', 'websiteDescription',
          'contactEmail', 'footerText', 'privacyPolicy', 'termsConditions', 'disclaimer',
          'facebookUrl', 'twitterUrl', 'telegramUrl', 'youtubeUrl',
          'maintenanceMode', 'directDownloadsEnabled', 'requireChecksumVerification',
          'maxDownloadSpeedLabel', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'websiteName', 'websiteLogoUrl', 'websiteFaviconUrl', 'websiteDescription',
          'contactEmail', 'footerText', 'privacyPolicy', 'termsConditions', 'disclaimer',
          'facebookUrl', 'twitterUrl', 'telegramUrl', 'youtubeUrl',
          'maintenanceMode', 'directDownloadsEnabled', 'requireChecksumVerification',
          'maxDownloadSpeedLabel', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.websiteName is string && data.websiteName.size() >= 1 && data.websiteName.size() <= 120
        && data.websiteLogoUrl is string && data.websiteLogoUrl.size() <= 100000
        && data.websiteFaviconUrl is string && data.websiteFaviconUrl.size() <= 100000
        && data.websiteDescription is string && data.websiteDescription.size() <= 1000
        && data.contactEmail is string && data.contactEmail.size() <= 256
        && data.footerText is string && data.footerText.size() <= 500
        && data.privacyPolicy is string && data.privacyPolicy.size() <= 10000
        && data.termsConditions is string && data.termsConditions.size() <= 10000
        && data.disclaimer is string && data.disclaimer.size() <= 10000
        && data.facebookUrl is string && data.facebookUrl.size() <= 500
        && data.twitterUrl is string && data.twitterUrl.size() <= 500
        && data.telegramUrl is string && data.telegramUrl.size() <= 500
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 500
        && data.maintenanceMode is bool
        && data.directDownloadsEnabled is bool
        && data.requireChecksumVerification is bool
        && data.maxDownloadSpeedLabel is string && data.maxDownloadSpeedLabel.size() <= 80
        && data.updatedAt is timestamp;
    }

    // 1. /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(adminUid)
        && isValidAdminRole(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role'])
        && isAdmin();
      allow delete: if isSignedIn() && isValidId(adminUid) && isBootstrappedAdmin();
    }

    // 2. /adminProfiles/{adminUid} (PII Isolated to Owner Admin)
    match /adminProfiles/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid && isAdmin();
      allow list: if isSignedIn() && existing().uid == request.auth.uid && isAdmin();
      allow create: if isSignedIn()
        && isValidId(adminUid)
        && isValidAdminProfile(incoming())
        && request.auth.uid == adminUid
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(adminUid)
        && isValidAdminProfile(incoming())
        && request.auth.uid == adminUid
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'accountStatus', 'updatedAt'])
        && isAdmin();
      allow delete: if isSignedIn() && isValidId(adminUid) && isBootstrappedAdmin();
    }

    // 3. /apps/{appId}
    match /apps/{appId} {
      allow get: if isValidId(appId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status in ['active', 'inactive'];
      allow create: if isSignedIn()
        && isValidId(appId)
        && isValidApkApp(incoming())
        && incoming().id == appId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(appId)
        && isValidApkApp(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['featured', 'trending', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['downloadEnabled', 'apkFileName', 'apkDownloadUrl', 'externalDownloadUrl', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['downloads', 'updatedAt']) && isAdmin()) ||
          isAdmin()
        );
      allow delete: if isSignedIn() && isValidId(appId) && isAdmin();
    }

    // 4. /games/{gameId}
    match /games/{gameId} {
      allow get: if isValidId(gameId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status in ['active', 'inactive'];
      allow create: if isSignedIn()
        && isValidId(gameId)
        && isValidApkApp(incoming())
        && incoming().id == gameId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(gameId)
        && isValidApkApp(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['featured', 'trending', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['downloadEnabled', 'apkFileName', 'apkDownloadUrl', 'externalDownloadUrl', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['downloads', 'updatedAt']) && isAdmin()) ||
          isAdmin()
        );
      allow delete: if isSignedIn() && isValidId(gameId) && isAdmin();
    }

    // 5. /categories/{categoryId}
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status in ['active', 'inactive'];
      allow create: if isSignedIn()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && isAdmin()) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'iconUrl', 'totalApps', 'status', 'updatedAt']) && isAdmin()) ||
          isAdmin()
        );
      allow delete: if isSignedIn() && isValidId(categoryId) && isAdmin();
    }

    // 6. /banners/{bannerId}
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (existing().status == 'active' || isAdmin());
      allow list: if existing().status in ['active', 'inactive'];
      allow create: if isSignedIn()
        && isValidId(bannerId)
        && isValidBanner(incoming())
        && incoming().id == bannerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(bannerId)
        && isValidBanner(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && isAdmin()) ||
          isAdmin()
        );
      allow delete: if isSignedIn() && isValidId(bannerId) && isAdmin();
    }

    // 7. /downloadEvents/{eventId}
    match /downloadEvents/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && isAdmin();
      allow list: if isSignedIn() && existing().targetType in ['app', 'game'] && isAdmin();
      allow create: if isSignedIn()
        && isValidId(eventId)
        && isValidDownloadEvent(incoming())
        && incoming().id == eventId
        && incoming().createdAt == request.time
        && isAdmin();
      allow update, delete: if isSignedIn() && isValidId(eventId) && isAdmin();
    }

    // 8. /analytics/{metricId}
    match /analytics/{metricId} {
      allow get: if isSignedIn() && isValidId(metricId) && isAdmin();
      allow list: if isSignedIn() && existing().periodType in ['daily', 'weekly', 'monthly'] && isAdmin();
      allow create: if isSignedIn()
        && isValidId(metricId)
        && isValidAnalyticsSummary(incoming())
        && incoming().id == metricId
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(metricId)
        && isValidAnalyticsSummary(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['downloads', 'label', 'updatedAt']) && isAdmin()) ||
          isAdmin()
        );
      allow delete: if isSignedIn() && isValidId(metricId) && isAdmin();
    }

    // 9. /websiteSettings/{settingId}
    match /websiteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if existing().id == 'global';
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidWebsiteSettings(incoming())
        && incoming().id == settingId
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidWebsiteSettings(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isSignedIn() && isValidId(settingId) && isBootstrappedAdmin();
    }
  }
}
